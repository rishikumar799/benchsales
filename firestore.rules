rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to verify user identity matches the document path UID
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Helper function to check if user is a Platform Admin
    function isPlatformAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@AryxAI.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'platform_admin')
      );
    }

    // Helper function for fetching user document
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper functions for University Authorization
    function isMemberOfUniversity(universityId) {
      return isAuthenticated() && getUserData().organizationId == universityId && getUserData().organizationType == 'university';
    }

    function isUnivAdmin(universityId) {
      return isMemberOfUniversity(universityId) && getUserData().role == 'organization_admin';
    }

    function isPlacementOfficer(universityId) {
      return isMemberOfUniversity(universityId) && getUserData().role == 'placement_officer';
    }

    function isStudent(universityId) {
      return isMemberOfUniversity(universityId) && getUserData().role == 'student';
    }

    // Helper functions for Company Authorization
    function isMemberOfCompany(companyId) {
      return isAuthenticated() && getUserData().organizationId == companyId && getUserData().organizationType == 'company';
    }

    function isCompanyAdmin(companyId) {
      return isMemberOfCompany(companyId) && getUserData().role == 'organization_admin';
    }

    function isCompanyRecruiter(companyId) {
      return isMemberOfCompany(companyId) && getUserData().role == 'recruiter';
    }

    function isCompanyEmployee(companyId) {
      return isMemberOfCompany(companyId) && getUserData().role == 'employee';
    }

    // Core users metadata
    match /users/{uid} {
      allow read: if isAuthenticated() || isPlatformAdmin() || (resource != null && resource.data.role == 'platform_admin');
      allow write: if isAuthenticated() || isPlatformAdmin();
    }

    // BDM specific profile
    match /marketplace_bdms/{uid} {
      allow read, write: if isOwner(uid) || isPlatformAdmin();
    }

    // Recruiter specific profile
    match /marketplace_recruiters/{uid} {
      allow read, write: if isOwner(uid) || isPlatformAdmin();

      match /saved_candidates/{candidateId} {
        allow read, write: if isOwner(uid) || isPlatformAdmin();
      }
    }

    // Jobseeker (student) specific profile
    match /marketplace_jobseekers/{uid} {
      allow read: if isAuthenticated() || isPlatformAdmin();
      allow write: if isOwner(uid) || isPlatformAdmin();
    }

    // University collection rules
    match /organizations_universities/{universityId} {
      allow read: if isPlatformAdmin() || (isAuthenticated() && isMemberOfUniversity(universityId));
      allow write: if isPlatformAdmin() || (isAuthenticated() && isUnivAdmin(universityId));

      match /admins/{uid} {
        allow read: if isPlatformAdmin() || (isAuthenticated() && isMemberOfUniversity(universityId));
        allow write: if isPlatformAdmin() || (isAuthenticated() && isUnivAdmin(universityId));

        match /activity/{activityId} {
          allow read, write: if isPlatformAdmin() || (isAuthenticated() && isUnivAdmin(universityId) && isOwner(uid));
        }
      }

      match /placement_officers/{uid} {
        allow read: if isPlatformAdmin() || (isAuthenticated() && isMemberOfUniversity(universityId));
        allow write: if isPlatformAdmin() || (isAuthenticated() && (isUnivAdmin(universityId) || (isOwner(uid) && isPlacementOfficer(universityId))));

        match /activity/{activityId} {
          allow read, write: if isPlatformAdmin() || (isAuthenticated() && isPlacementOfficer(universityId) && isOwner(uid));
        }
      }

      match /students/{uid} {
        allow read: if isPlatformAdmin() || (isAuthenticated() && isMemberOfUniversity(universityId) && (isUnivAdmin(universityId) || isPlacementOfficer(universityId) || isOwner(uid)));
        allow write: if isPlatformAdmin() || (isAuthenticated() && isMemberOfUniversity(universityId) && (isUnivAdmin(universityId) || isPlacementOfficer(universityId) || (isOwner(uid) && isStudent(universityId))));

        match /activity/{activityId} {
          allow read, write: if isPlatformAdmin() || (isAuthenticated() && isStudent(universityId) && isOwner(uid));
        }
      }

      match /departments/{deptId} {
        allow read: if isPlatformAdmin() || (isAuthenticated() && isMemberOfUniversity(universityId));
        allow write: if isPlatformAdmin() || (isAuthenticated() && isUnivAdmin(universityId));
      }

      match /opportunities/{oppId} {
        allow read: if isPlatformAdmin() || (isAuthenticated() && isMemberOfUniversity(universityId));
        allow write: if isPlatformAdmin() || (isAuthenticated() && isMemberOfUniversity(universityId) && (isUnivAdmin(universityId) || isPlacementOfficer(universityId)));
      }

      match /placements/{placId} {
        allow read: if isPlatformAdmin() || (isAuthenticated() && isMemberOfUniversity(universityId));
        allow write: if isPlatformAdmin() || (isAuthenticated() && isMemberOfUniversity(universityId) && (isUnivAdmin(universityId) || isPlacementOfficer(universityId)));
      }

      match /applications/{appId} {
        allow read: if isPlatformAdmin() || (isAuthenticated() && isMemberOfUniversity(universityId));
        allow write: if isPlatformAdmin() || (isAuthenticated() && isMemberOfUniversity(universityId) && (isUnivAdmin(universityId) || isPlacementOfficer(universityId) || isStudent(universityId)));
      }

      match /activity/{activityId} {
        allow read: if isPlatformAdmin() || (isAuthenticated() && isMemberOfUniversity(universityId));
        allow write: if isPlatformAdmin() || (isAuthenticated() && isMemberOfUniversity(universityId) && (isUnivAdmin(universityId) || isPlacementOfficer(universityId));
      }

      match /notifications/{notificationId} {
        allow read: if isPlatformAdmin() || (isAuthenticated() && isMemberOfUniversity(universityId));
        allow write: if isPlatformAdmin() || (isAuthenticated() && isMemberOfUniversity(universityId) && (isUnivAdmin(universityId) || isPlacementOfficer(universityId)));
      }

      match /reports/{reportId} {
        allow read, write: if isPlatformAdmin() || (isAuthenticated() && isMemberOfUniversity(universityId) && (isUnivAdmin(universityId) || isPlacementOfficer(universityId)));
      }
    }

    // Company collection rules
    match /organizations_companies/{companyId} {
      allow read: if isPlatformAdmin() || (isAuthenticated() && isMemberOfCompany(companyId));
      allow write: if isPlatformAdmin() || (isAuthenticated() && isCompanyAdmin(companyId));

      match /admins/{uid} {
        allow read: if isPlatformAdmin() || (isAuthenticated() && isMemberOfCompany(companyId));
        allow write: if isPlatformAdmin() || (isAuthenticated() && isCompanyAdmin(companyId));

        match /activity/{activityId} {
          allow read, write: if isPlatformAdmin() || (isAuthenticated() && isCompanyAdmin(companyId) && isOwner(uid));
        }
      }

      match /recruiters/{uid} {
        allow read: if isPlatformAdmin() || (isAuthenticated() && isMemberOfCompany(companyId));
        allow write: if isPlatformAdmin() || (isAuthenticated() && (isCompanyAdmin(companyId) || (isOwner(uid) && isCompanyRecruiter(companyId))));

        match /activity/{activityId} {
          allow read, write: if isPlatformAdmin() || (isAuthenticated() && isCompanyRecruiter(companyId) && isOwner(uid));
        }
      }

      match /employees/{uid} {
        allow read: if isPlatformAdmin() || (isAuthenticated() && isMemberOfCompany(companyId) && (isCompanyAdmin(companyId) || isCompanyRecruiter(companyId) || isOwner(uid)));
        allow write: if isPlatformAdmin() || (isAuthenticated() && isMemberOfCompany(companyId) && (isCompanyAdmin(companyId) || (isOwner(uid) && isCompanyEmployee(companyId))));

        match /activity/{activityId} {
          allow read, write: if isPlatformAdmin() || (isAuthenticated() && isCompanyEmployee(companyId) && isOwner(uid));
        }
      }

      match /departments/{deptId} {
        allow read: if isPlatformAdmin() || (isAuthenticated() && isMemberOfCompany(companyId));
        allow write: if isPlatformAdmin() || (isAuthenticated() && isCompanyAdmin(companyId));
      }

      match /jobs/{jobId} {
        allow read, write: if isPlatformAdmin() || (isAuthenticated() && isMemberOfCompany(companyId) && (isCompanyAdmin(companyId) || isCompanyRecruiter(companyId)));
      }

      match /applications/{appId} {
        allow read, write: if isPlatformAdmin() || (isAuthenticated() && isMemberOfCompany(companyId) && (isCompanyAdmin(companyId) || isCompanyRecruiter(companyId)));
      }

      match /documents/{docId} {
        allow read: if isPlatformAdmin() || (isAuthenticated() && isMemberOfCompany(companyId) && (isCompanyAdmin(companyId) || isCompanyRecruiter(companyId) || (isCompanyEmployee(companyId) && request.auth.uid == resource.data.employeeUid)));
        allow write: if isPlatformAdmin() || (isAuthenticated() && isMemberOfCompany(companyId) && (isCompanyAdmin(companyId) || isCompanyRecruiter(companyId) || (isCompanyEmployee(companyId) && request.auth.uid == request.resource.data.employeeUid)));
      }

      match /activity/{activityId} {
        allow read: if isPlatformAdmin() || (isAuthenticated() && isMemberOfCompany(companyId) && (isCompanyAdmin(companyId) || isCompanyRecruiter(companyId)));
        allow write: if isPlatformAdmin() || (isAuthenticated() && isCompanyAdmin(companyId));
      }

      match /notifications/{notificationId} {
        allow read: if isPlatformAdmin() || (isAuthenticated() && isMemberOfCompany(companyId));
        allow write: if isPlatformAdmin() || (isAuthenticated() && isCompanyAdmin(companyId));
      }

      match /reports/{reportId} {
        allow read, write: if isPlatformAdmin() || (isAuthenticated() && isCompanyAdmin(companyId));
      }
    }

    // Global jobs
    match /marketplace_jobs/{jobId} {
      allow read: if isAuthenticated() || isPlatformAdmin();
      allow create: if isPlatformAdmin() || (isAuthenticated() && request.auth.uid == request.resource.data.createdBy);
      allow update, delete: if isPlatformAdmin() || (isAuthenticated() && request.auth.uid == resource.data.createdBy);

      match /{subcollection}/{documentId} {
        allow read: if isAuthenticated() || isPlatformAdmin();
        allow write: if isPlatformAdmin() || (isAuthenticated() && get(/databases/$(database)/documents/marketplace_jobs/$(jobId)).data.createdBy == request.auth.uid);
      }
    }

    // Global job applications
    match /marketplace_applications/{applicationId} {
      allow read, write: if isAuthenticated() || isPlatformAdmin();
    }

    // Global submissions
    match /marketplace_submissions/{submissionId} {
      allow read, write: if isAuthenticated() || isPlatformAdmin();
    }

    // User specific notifications
    match /notifications/{uid} {
      allow read, write: if isOwner(uid) || isPlatformAdmin();
    }

    // Platform Specific Collections
    match /platform_admins/{uid} {
      allow read, write: if isOwner(uid) || isPlatformAdmin();
    }

    match /platform_settings/{docId} {
      allow read: if isAuthenticated() || isPlatformAdmin();
      allow write: if isPlatformAdmin();
    }

    match /system_metrics/{docId} {
      allow read: if isAuthenticated() || isPlatformAdmin();
      allow write: if isPlatformAdmin();
    }

    match /dashboard_metrics/{docId} {
      allow read: if isAuthenticated() || isPlatformAdmin();
      allow write: if isPlatformAdmin();
    }

    match /platform_analytics/{docId} {
      allow read: if isAuthenticated() || isPlatformAdmin();
      allow write: if isPlatformAdmin();
    }

    match /audit_logs/{id} {
      allow read: if isAuthenticated() || isPlatformAdmin();
      allow write: if isAuthenticated() || isPlatformAdmin();
    }

    match /login_logs/{id} {
      allow read: if isAuthenticated() || isPlatformAdmin();
      allow write: if isAuthenticated() || isPlatformAdmin();
    }

    // System collection: read-only for authenticated, write-only by platform admins
    match /system/{document=**} {
      allow read: if isAuthenticated() || isPlatformAdmin();
      allow write: if isPlatformAdmin();
    }
  }
}
