rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to verify user identity matches the document path UID
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Core users metadata: read/write allowed if you are authenticated
    match /users/{uid} {
      allow read, write: if isAuthenticated();
    }

    // BDM specific profile: read/write allowed only for the BDM owner
    match /marketplace_bdms/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Recruiter specific profile: read/write allowed only for the Recruiter owner
    match /marketplace_recruiters/{uid} {
      allow read, write: if isOwner(uid);

      match /saved_candidates/{candidateId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Jobseeker (student) specific profile: read allowed by authenticated users, write restricted strictly to the document owner
    match /marketplace_jobseekers/{uid} {
      allow read: if isAuthenticated();
      allow write: if isOwner(uid);
    }

    // Helper functions for University Authorization
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isMemberOfUniversity(universityId) {
      return isAuthenticated() && getUserData().organizationId == universityId && getUserData().organizationType == 'university';
    }

    function isUnivAdmin(universityId) {
      return isMemberOfUniversity(universityId) && getUserData().role == 'organization_admin';
    }

    function isPlacementOfficer(universityId) {
      return isMemberOfUniversity(universityId) && getUserData().role == 'placement_officer';
    }

    function isStudent(universityId) {
      return isMemberOfUniversity(universityId) && getUserData().role == 'student';
    }

    // Helper functions for Company Authorization
    function isMemberOfCompany(companyId) {
      return isAuthenticated() && getUserData().organizationId == companyId && getUserData().organizationType == 'company';
    }

    function isCompanyAdmin(companyId) {
      return isMemberOfCompany(companyId) && getUserData().role == 'organization_admin';
    }

    function isCompanyRecruiter(companyId) {
      return isMemberOfCompany(companyId) && getUserData().role == 'recruiter';
    }

    function isCompanyEmployee(companyId) {
      return isMemberOfCompany(companyId) && getUserData().role == 'employee';
    }

    // University collection rules
    match /organizations_universities/{universityId} {
      allow read: if isAuthenticated() && isMemberOfUniversity(universityId);
      allow write: if isAuthenticated() && isUnivAdmin(universityId);

      match /admins/{uid} {
        allow read: if isAuthenticated() && isMemberOfUniversity(universityId);
        allow write: if isAuthenticated() && isUnivAdmin(universityId);

        match /activity/{activityId} {
          allow read, write: if isAuthenticated() && isUnivAdmin(universityId) && isOwner(uid);
        }
      }

      match /placement_officers/{uid} {
        allow read: if isAuthenticated() && isMemberOfUniversity(universityId);
        allow write: if isAuthenticated() && (isUnivAdmin(universityId) || (isOwner(uid) && isPlacementOfficer(universityId)));

        match /activity/{activityId} {
          allow read, write: if isAuthenticated() && isPlacementOfficer(universityId) && isOwner(uid);
        }
      }

      match /students/{uid} {
        allow read: if isAuthenticated() && isMemberOfUniversity(universityId) && (isUnivAdmin(universityId) || isPlacementOfficer(universityId) || isOwner(uid));
        allow write: if isAuthenticated() && isMemberOfUniversity(universityId) && (isUnivAdmin(universityId) || isPlacementOfficer(universityId) || (isOwner(uid) && isStudent(universityId)));

        match /activity/{activityId} {
          allow read, write: if isAuthenticated() && isStudent(universityId) && isOwner(uid);
        }
      }

      match /departments/{deptId} {
        allow read: if isAuthenticated() && isMemberOfUniversity(universityId);
        allow write: if isAuthenticated() && isUnivAdmin(universityId);
      }

      match /opportunities/{oppId} {
        allow read: if isAuthenticated() && isMemberOfUniversity(universityId);
        allow write: if isAuthenticated() && isMemberOfUniversity(universityId) && (isUnivAdmin(universityId) || isPlacementOfficer(universityId));
      }

      match /placements/{placId} {
        allow read: if isAuthenticated() && isMemberOfUniversity(universityId);
        allow write: if isAuthenticated() && isMemberOfUniversity(universityId) && (isUnivAdmin(universityId) || isPlacementOfficer(universityId));
      }

      match /applications/{appId} {
        allow read: if isAuthenticated() && isMemberOfUniversity(universityId);
        allow write: if isAuthenticated() && isMemberOfUniversity(universityId) && (isUnivAdmin(universityId) || isPlacementOfficer(universityId) || isStudent(universityId));
      }

      match /activity/{activityId} {
        allow read: if isAuthenticated() && isMemberOfUniversity(universityId);
        allow write: if isAuthenticated() && isMemberOfUniversity(universityId) && (isUnivAdmin(universityId) || isPlacementOfficer(universityId));
      }

      match /notifications/{notificationId} {
        allow read: if isAuthenticated() && isMemberOfUniversity(universityId);
        allow write: if isAuthenticated() && isMemberOfUniversity(universityId) && (isUnivAdmin(universityId) || isPlacementOfficer(universityId));
      }

      match /reports/{reportId} {
        allow read, write: if isAuthenticated() && isMemberOfUniversity(universityId) && (isUnivAdmin(universityId) || isPlacementOfficer(universityId));
      }
    }

    // Company collection rules
    match /organizations_companies/{companyId} {
      allow read: if isAuthenticated() && isMemberOfCompany(companyId);
      allow write: if isAuthenticated() && isCompanyAdmin(companyId);

      match /admins/{uid} {
        allow read: if isAuthenticated() && isMemberOfCompany(companyId);
        allow write: if isAuthenticated() && isCompanyAdmin(companyId);

        match /activity/{activityId} {
          allow read, write: if isAuthenticated() && isCompanyAdmin(companyId) && isOwner(uid);
        }
      }

      match /recruiters/{uid} {
        allow read: if isAuthenticated() && isMemberOfCompany(companyId);
        allow write: if isAuthenticated() && (isCompanyAdmin(companyId) || (isOwner(uid) && isCompanyRecruiter(companyId)));

        match /activity/{activityId} {
          allow read, write: if isAuthenticated() && isCompanyRecruiter(companyId) && isOwner(uid);
        }
      }

      match /employees/{uid} {
        allow read: if isAuthenticated() && isMemberOfCompany(companyId) && (isCompanyAdmin(companyId) || isCompanyRecruiter(companyId) || isOwner(uid));
        allow write: if isAuthenticated() && isMemberOfCompany(companyId) && (isCompanyAdmin(companyId) || (isOwner(uid) && isCompanyEmployee(companyId)));

        match /activity/{activityId} {
          allow read, write: if isAuthenticated() && isCompanyEmployee(companyId) && isOwner(uid);
        }
      }

      match /departments/{deptId} {
        allow read: if isAuthenticated() && isMemberOfCompany(companyId);
        allow write: if isAuthenticated() && isCompanyAdmin(companyId);
      }

      match /jobs/{jobId} {
        allow read, write: if isAuthenticated() && isMemberOfCompany(companyId) && (isCompanyAdmin(companyId) || isCompanyRecruiter(companyId));
      }

      match /applications/{appId} {
        allow read, write: if isAuthenticated() && isMemberOfCompany(companyId) && (isCompanyAdmin(companyId) || isCompanyRecruiter(companyId));
      }

      match /documents/{docId} {
        allow read: if isAuthenticated() && isMemberOfCompany(companyId) && (isCompanyAdmin(companyId) || isCompanyRecruiter(companyId) || (isCompanyEmployee(companyId) && request.auth.uid == resource.data.employeeUid));
        allow write: if isAuthenticated() && isMemberOfCompany(companyId) && (isCompanyAdmin(companyId) || isCompanyRecruiter(companyId) || (isCompanyEmployee(companyId) && request.auth.uid == request.resource.data.employeeUid));
      }

      match /activity/{activityId} {
        allow read: if isAuthenticated() && isMemberOfCompany(companyId) && (isCompanyAdmin(companyId) || isCompanyRecruiter(companyId));
        allow write: if isAuthenticated() && isCompanyAdmin(companyId);
      }

      match /notifications/{notificationId} {
        allow read: if isAuthenticated() && isMemberOfCompany(companyId);
        allow write: if isAuthenticated() && isCompanyAdmin(companyId);
      }

      match /reports/{reportId} {
        allow read, write: if isAuthenticated() && isCompanyAdmin(companyId);
      }
    }

    // Global jobs: read allowed by all authenticated, write allowed by BDM or authorized managers
    match /marketplace_jobs/{jobId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.createdBy;
      allow update, delete: if isAuthenticated() && request.auth.uid == resource.data.createdBy;

      // Subcollections of marketplace_jobs (activity, timeline, assigned_recruiters, submissions, etc.)
      match /{subcollection}/{documentId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && get(/databases/$(database)/documents/marketplace_jobs/$(jobId)).data.createdBy == request.auth.uid;
      }
    }

    // Global job applications: read and write by any authenticated marketplace member (students apply, recruiters/BDMs view)
    match /marketplace_applications/{applicationId} {
      allow read, write: if isAuthenticated();
    }

    // Global submissions: read and write by any authenticated recruiter/BDM/student involved
    match /marketplace_submissions/{submissionId} {
      allow read, write: if isAuthenticated();
    }

    // Notifications: read and write allowed only for the target user owner
    match /notifications/{uid} {
      allow read, write: if isOwner(uid);
    }

    // System collection: read-only for authenticated, write-only by platform admins
    match /system/{document=**} {
      allow read: if isAuthenticated();
      allow write: if false; // Only manageable via Firebase Console / Admin SDK
    }
  }
}
