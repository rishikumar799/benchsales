  "firestore": {
    "users/{uid}": {
      "schema": "User",
      "description": "Core Auth user metadata mapping"
    },
    "marketplace_bdms/{uid}": {
      "schema": "MarketplaceBDM",
      "description": "BDM-specific notes, cache, and draft jobs"
